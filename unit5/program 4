
import csv
import matplotlib.pyplot as plt

# Sample retail sales data
sales_data = [
    ["Product", "Quantity", "Price"],
    ["Laptop", 5, 50000],
    ["Mobile", 10, 20000],
    ["Headphones", 15, 2000],
    ["Keyboard", 8, 1500],
    ["Mouse", 12, 800]
]

# Create CSV file
with open("sales.csv", "w", newline="") as file:
    writer = csv.writer(file)
    writer.writerows(sales_data)

# Read CSV file
products = []
revenues = []

with open("sales.csv", "r") as file:
    reader = csv.DictReader(file)

    for row in reader:
        product = row["Product"]
        quantity = int(row["Quantity"])
        price = float(row["Price"])

        revenue = quantity * price

        products.append(product)
        revenues.append(revenue)

# Calculate sales
total_sales = sum(revenues)
highest = max(revenues)

best_product = products[revenues.index(highest)]

print("===== RETAIL SALES DASHBOARD =====")
print("Total Revenue: Rs.", total_sales)
print("Highest Selling Product:", best_product)
print("Highest Product Revenue: Rs.", highest)

# Bar chart
plt.figure(figsize=(9, 5))
plt.bar(products, revenues)
plt.title("Retail Sales Analysis")
plt.xlabel("Products")
plt.ylabel("Revenue (Rs.)")
plt.grid(axis="y")
plt.tight_layout()
plt.show()

# Pie chart
plt.figure(figsize=(7, 7))
plt.pie(revenues, labels=products, autopct="%1.1f%%")
plt.title("Product-wise Sales Distribution")
plt.show()
