
student = input("Enter student name: ")

marks = []

for i in range(1, 6):
    mark = float(input(f"Enter subject {i} marks: "))
    marks.append(mark)

total = sum(marks)
average = total / 5

if average >= 90:
    grade = "A+"
elif average >= 80:
    grade = "A"
elif average >= 70:
    grade = "B"
elif average >= 60:
    grade = "C"
elif average >= 40:
    grade = "D"
else:
    grade = "Fail"

print("\n===== STUDENT RESULT =====")
print("Student Name:", student)
print("Total Marks:", total)
print("Average:", average)
print("Grade:", grade)
